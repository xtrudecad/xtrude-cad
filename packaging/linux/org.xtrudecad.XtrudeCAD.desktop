[Desktop Entry]
Type=Application
Name=Xtrude CAD
GenericName=3D Modeller
Comment=Push/pull 3D modelling for 3D-printable parts
Exec=xtrude %f
Icon=org.xtrudecad.XtrudeCAD
Terminal=false
Categories=Graphics;3DGraphics;Engineering;
Keywords=CAD;3D;modelling;printing;STL;
MimeType=application/x-xtrudecad;application/x-ingetrazo;image/vnd.dxf;model/stl;model/obj;
StartupNotify=true
StartupWMClass=org.xtrudecad.XtrudeCAD
